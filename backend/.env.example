# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# --- Local development with docker-compose ---
ARANGO_URL=http://localhost:8529
ARANGO_DB=popote
ARANGO_USER=root
ARANGO_PASSWORD=popote

# --- Shared/hosted ArangoDB (used by the deployed backend) ---
# ARANGO_URL=https://arango.tomansion.fr
# ARANGO_DB=PoPote
# ARANGO_USER=PoPote
# ARANGO_PASSWORD=<ask Tom / see the deployment secret store>

# Comma-separated allowed origins, or * for any.
# The APK's origin is https://localhost, so it must be listed when not using *.
CORS_ORIGINS=*

# Give each newly registered account its own copy of the demo recipes.
SEED_DEMO_DATA=true

# --- Sessions ---
# Leave unset: the backend generates a signing key on first start and stores it
# in ArangoDB, so tokens keep working across restarts and redeploys. Set it
# only to share one key across several backend instances. Changing it signs
# everyone out.
# JWT_SECRET=
# How long a session lasts. Long on purpose — nobody should have to log in
# again on their phone every few weeks.
JWT_TTL_DAYS=3650

# --- AI recipe/image generation ---
# Leave empty and both features are simply disabled — this whole area is
# optional flavor on top of the core CRUD.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Object storage (generated recipe images), via docker-compose-dev.yml's minio ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=popote
MINIO_SECRET_KEY=popote1234
MINIO_BUCKET=popote-recipes
# What the *browser* can reach — same host as MINIO_ENDPOINT in dev, but
# usually different in production, where MINIO_ENDPOINT is an internal
# container hostname.
MINIO_PUBLIC_URL=http://localhost:9000

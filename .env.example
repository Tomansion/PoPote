# Optional overrides for docker-compose. Copy to .env (gitignored).
# Without this file the stack runs entirely locally against the bundled
# ArangoDB container, which is the normal way to develop.

# Password for the bundled ArangoDB container (local only).
ARANGO_ROOT_PASSWORD=popote

# --- Point the stack at the shared hosted ArangoDB instead ---
# ARANGO_URL=https://arango.tomansion.fr
# ARANGO_DB=PoPote
# ARANGO_USER=PoPote
# ARANGO_PASSWORD=<see the deployment secret store>

# Restrict in production, e.g.:
# CORS_ORIGINS=https://popote.tomansion.fr,https://localhost
CORS_ORIGINS=*

SEED_DEMO_DATA=true

# --- Sessions ---
# Leave unset: the backend generates a signing key on first start and stores it
# in ArangoDB, so tokens keep working across restarts and redeploys. Set it
# only to share one key across several backend instances. Changing it signs
# everyone out.
# JWT_SECRET=
# How long a session lasts. Long on purpose — nobody should have to log in
# again on their phone every few weeks.
JWT_TTL_DAYS=3650

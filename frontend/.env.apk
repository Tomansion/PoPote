# Used by `vite build --mode apk` (npm run build:apk).
#
# The APK has no useful origin of its own — it is served from https://localhost
# inside the WebView — so unlike the web build it cannot fall back to a relative
# "/api" path and must point at the deployed backend explicitly.
VITE_API_URL=https://everymeal.tomansion.fr/api

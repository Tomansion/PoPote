{
  "name": "popote-frontend",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "build:apk": "vite build --mode apk",
    "apk:add": "cap add android",
    "apk:sync": "npm run build:apk && cap sync android",
    "apk:assets": "capacitor-assets generate --android",
    "apk:build": "npm run apk:sync && npm run apk:assets && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@mdi/font": "^7.4.47",
    "dexie": "^4.4.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "vuetify": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "sass-embedded": "^1.103.1",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.3"
  }
}
